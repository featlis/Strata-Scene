<Window x:Class="StrataScene.App.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strata Scene Launcher"
        Width="640" Height="420"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1E1E22"
        BorderBrush="#383842"
        BorderThickness="1">
    <Window.Resources>
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#282830" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#404050" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Input -->
        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 Style="{StaticResource SearchBoxStyle}"
                 PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                 TextChanged="OnSearchBoxTextChanged" />

        <!-- Candidate Results List -->
        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single"
                 PreviewKeyDown="OnResultsListPreviewKeyDown"
                 MouseDoubleClick="OnResultsListMouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#353545" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2B2B38" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon / Dot -->
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#707080" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Color, TargetNullValue=''}" Value="">
                                            <Setter Property="Fill" Value="#888899" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Color, FallbackValue='#0078D4', TargetNullValue='#888899'}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Title and Subtitle -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#FFFFFF"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Foreground="#9999A5"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding Subtitle, Converter={x:Null}}" />
                        </StackPanel>

                        <!-- Shortcut Badge -->
                        <Border Grid.Column="3"
                                Background="#2A2A35"
                                BorderBrush="#454555"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Shortcut}"
                                       Foreground="#BBBBC8"
                                       FontSize="11"
                                       FontFamily="Consolas, monospace" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
