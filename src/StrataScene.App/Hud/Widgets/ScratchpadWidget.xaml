<local:HudWidgetBase x:Class="StrataScene.App.Hud.Widgets.ScratchpadWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:StrataScene.App.Hud"
              Width="240" Height="30"
              SizeToContent="Manual">
    <Border x:Name="RootBorder"
            Background="#E61E1E1E"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Cursor="Hand"
            MouseLeftButtonUp="OnMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F22D2D2D" />
                        <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid VerticalAlignment="Center" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Memo Icon -->
            <TextBlock Grid.Column="0"
                       Text="📝"
                       FontSize="11"
                       VerticalAlignment="Center" />

            <!-- Display TextBlock -->
            <TextBlock x:Name="DisplayText"
                       Grid.Column="2"
                       Text="メモを入力..."
                       Foreground="#AAAAAA"
                       FontSize="11"
                       FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Visible" />

            <!-- Edit TextBox -->
            <TextBox x:Name="EditTextBox"
                     Grid.Column="2"
                     Background="Transparent"
                     Foreground="#FFFFFF"
                     BorderThickness="0"
                     FontSize="11"
                     FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"
                     PreviewKeyDown="OnEditTextBoxPreviewKeyDown"
                     LostFocus="OnEditTextBoxLostFocus" />
        </Grid>
    </Border>
</local:HudWidgetBase>
