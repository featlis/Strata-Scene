<local:HudWidgetBase x:Class="StrataScene.App.Hud.Widgets.FocusTimerWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:StrataScene.App.Hud"
              Width="110" Height="30"
              SizeToContent="Manual">
    <Border x:Name="RootBorder"
            Background="#E61E1E1E"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Cursor="Hand"
            MouseLeftButtonUp="OnMouseLeftButtonUp"
            MouseRightButtonUp="OnMouseRightButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F22D2D2D" />
                        <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status Indicator (Tomato for work, Green for break) -->
            <Ellipse x:Name="TimerIndicator"
                     Grid.Column="0"
                     Width="8" Height="8"
                     Fill="#E81123"
                     VerticalAlignment="Center" />

            <!-- Time Display -->
            <TextBlock x:Name="TimeText"
                       Grid.Column="2"
                       Text="25:00"
                       Foreground="#FFFFFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable, Segoe UI, Consolas, sans-serif"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</local:HudWidgetBase>
